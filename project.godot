; WESTSIDE LEGACY Mobile — Vanta Studio
; Archivo de configuración del proyecto Godot 4.7.

config_version=5

[application]

config/name="WESTSIDE LEGACY"
config/description="Respect Is Earned. Legacy Is Taken."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.039, 0.039, 0.055, 1)
boot_splash/show_image=false
run/low_processor_mode=false
config/project_settings_override="user://render_override.cfg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameData="*res://scripts/autoload/game_data.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Settings="*res://scripts/autoload/settings.gd"
Controls="*res://scripts/autoload/controls.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
rendering_device/driver.ios="metal"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
scaling_3d/mode=2
scaling_3d/scale=0.8
scaling_3d/fsr_sharpness=0.35
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
environment/ssao/half_size=true
environment/ssil/half_size=true
environment/screen_space_reflection/half_size=true
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=48
global_illumination/sdfgi/probe_ray_count=1
global_illumination/sdfgi/frames_to_converge=3
global_illumination/sdfgi/frames_to_update_lights=3
reflections/reflection_atlas/reflection_size=256
reflections/reflection_atlas/reflection_count=8
reflections/sky_reflections/roughness_layers=7
camera/depth_of_field/depth_of_field_bokeh_shape=1
camera/depth_of_field/depth_of_field_use_jitter=true
environment/defaults/default_clear_color=Color(0.039, 0.039, 0.055, 1)
